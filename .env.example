# Local development PostgreSQL. Replace the password before starting.
POSTGRES_DB=swarm_backend
POSTGRES_USER=swarm
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432

# Keep this URL synchronized with the PostgreSQL variables above.
# URL-encode special characters in the username or password.
# NestJS running on the host uses localhost; containers use postgres:5432.
DATABASE_URL=postgresql://swarm:change_me_local_password@localhost:5432/swarm_backend?schema=public

# Search service. Generate a random secret before starting the full stack.
SEARXNG_SECRET=change_me_to_a_random_secret
SEARXNG_PORT=8080
# Rolling official image for local development; use an immutable digest for deployment.
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
# NestJS on the host uses this URL. Docker services use http://searxng:8080.
SEARXNG_URL=http://localhost:8080

# Chromium + Playwright + Stagehand dependency runtime (health endpoint only).
BROWSER_RUNTIME_PORT=3001
BROWSER_RUNTIME_URL=http://localhost:3001

# Application and worker configuration
PORT=3000
DOCKER_DATABASE_URL=postgresql://swarm:change_me_local_password@postgres:5432/swarm_backend?schema=public
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_IMAGE=temporalio/temporal:latest
AUTH_CREDENTIALS='[{"token":"replace_with_at_least_32_random_characters","tenantId":"local","userId":"developer","projectIds":["demo"],"capabilities":["search","browser","research"]}]'
# Exact host allowlist. Include required public CDN hosts; subdomains are not implicit.
BROWSER_ALLOWED_DOMAINS=example.com
# Browser worker runtime. Headless mode never changes CHROMIUM_SANDBOX.
BROWSER_HEADLESS=true
BROWSER_LAUNCH_TIMEOUT_MS=30000
# Attach Stagehand 4.1.0 to each session's own Chromium (full Chromium + bundled extension).
STAGEHAND_ENABLED=false
STAGEHAND_CONNECT_TIMEOUT_MS=30000
# Semantic observe/act steps. Model calls run in the browser worker process, never in Chromium.
# none: semantic steps fail with MODEL_NOT_CONFIGURED. anthropic: requires ANTHROPIC_API_KEY.
STAGEHAND_MODEL_PROVIDER=none
STAGEHAND_MODEL=claude-opus-5-5
STAGEHAND_MODEL_EFFORT=medium
STAGEHAND_MODEL_TIMEOUT_MS=60000
STAGEHAND_MODEL_MAX_RETRIES=2
STAGEHAND_ACTION_TIMEOUT_MS=120000
# Model usage per semantic step (observe, act, extract); extract makes 2 calls per page chunk.
STAGEHAND_STEP_MAX_MODEL_CALLS=12
STAGEHAND_STEP_MAX_MODEL_TOKENS=300000
# Largest structured extraction result accepted, in bytes of JSON.
EXTRACT_MAX_RESULT_BYTES=65536
# Approval of consequential browser actions (submit steps). The TTL (browser worker) is
# 60000-1200000 ms; it must fit inside the 30 min workflow. Approvers need the "approve"
# capability in AUTH_CREDENTIALS and, by default (API), must differ from the run submitter.
APPROVAL_TTL_MS=600000
APPROVAL_REQUIRE_DISTINCT_APPROVER=true
# Secret: set only for the browser worker; never committed or logged.
ANTHROPIC_API_KEY=
ARTIFACT_ROOT=.data/artifacts
SEARCH_MAX_CONCURRENT_ACTIVITIES=2
SEARCH_REQUEST_TIMEOUT_MS=15000
